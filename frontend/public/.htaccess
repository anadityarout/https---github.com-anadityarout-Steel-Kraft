# ==========================================
# SECURITY HEADERS
# ==========================================

<IfModule mod_headers.c>

    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    <FilesMatch "^(ard\.json|llms\.txt)$">
        Header always set Access-Control-Allow-Origin "*"
    </FilesMatch>

</IfModule>


# ==========================================
# JAVASCRIPT AND JSON MIME TYPES
# ==========================================

<IfModule mod_mime.c>

    AddType application/javascript .js
    AddType application/json .json
    AddType "text/plain; charset=UTF-8" .txt

</IfModule>


# ==========================================
# COMPRESSION (smaller downloads = faster page)
# Brotli is used when the server supports it,
# otherwise gzip.
# ==========================================

<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml application/xml application/javascript text/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript text/javascript application/json image/svg+xml font/ttf font/otf application/x-font-ttf
</IfModule>


# ==========================================
# BROWSER CACHING
# JS and CSS files built by Vite have a hash in the
# file name, so they are safe to cache for a year.
# HTML is NOT cached here (seo.php controls it).
# ==========================================

<IfModule mod_expires.c>

    ExpiresActive On

    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"

    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/avif "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"

</IfModule>

<IfModule mod_headers.c>

    <FilesMatch "\.(js|css|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

</IfModule>


# ==========================================
# URL REWRITING AND SEO
# ==========================================

<IfModule mod_rewrite.c>

    RewriteEngine On

    # Disable MultiViews for React routes.
    Options -MultiViews

    # --------------------------------------
    # FORCE HTTPS AND NON-WWW
    # --------------------------------------

    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} ^www\.steelcraftprefab\.com$ [NC]

    RewriteRule ^ https://steelcraftprefab.com%{REQUEST_URI} [R=301,L,NE]


    # --------------------------------------
    # REDIRECT DIRECT INDEX AND PHP ACCESS
    # --------------------------------------

    RewriteCond %{THE_REQUEST} \s/+(index\.html|seo\.php)[\s?] [NC]

    RewriteRule ^ https://steelcraftprefab.com/ [R=301,L]


    # --------------------------------------
    # ALLOW DISCOVERY FILES
    # --------------------------------------

    RewriteRule ^\.well-known/ard\.json$ - [L]
    RewriteRule ^llms\.txt$ - [L]


    # --------------------------------------
    # ALLOW EXISTING ASSETS AND FILES
    # EXCEPT index.html
    # --------------------------------------

    RewriteCond %{REQUEST_URI} !^/index\.html$ [NC]
    RewriteCond %{REQUEST_FILENAME} -f

    RewriteRule ^ - [L]


    # --------------------------------------
    # SEND WEBSITE ROUTES THROUGH SEO.PHP
    # --------------------------------------

    RewriteRule ^ seo.php [L,QSA]

</IfModule>